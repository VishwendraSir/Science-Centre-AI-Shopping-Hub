rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "oGx22qVkoeOboM1bNAgIdKTqXY12"
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if isAdmin() || resource.data.active == true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{settingsId} {
      allow read: if settingsId == "main";
      allow create, update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.id == orderId
        && request.resource.data.status == "Pending"
        && request.resource.data.name is string
        && request.resource.data.phone is string
        && request.resource.data.address is string
        && request.resource.data.pincode is string
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.subtotalPaise is int
        && request.resource.data.deliveryFeePaise is int
        && request.resource.data.discountPaise is int
        && request.resource.data.totalPaise is int
        && request.resource.data.subtotalPaise >= 0
        && request.resource.data.deliveryFeePaise >= 0
        && request.resource.data.discountPaise >= 0
        && request.resource.data.totalPaise >= 0
        && request.resource.data.keys().hasOnly([
          "id", "userId", "name", "phone", "address", "pincode", "status",
          "subtotalPaise", "deliveryFeePaise", "totalPaise", "items",
          "payment", "date", "note", "discountPaise", "couponCode"
        ]);
      allow get: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}