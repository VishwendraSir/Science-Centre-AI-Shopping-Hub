rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner() { return signedIn() && request.auth.uid == "oGx22qVkoeOboM1bNAgIdKTqXY12"; }
    // Custom claims must be issued only by trusted Admin SDK code.
    function hasRole(r) { return signedIn() && request.auth.token.role == r; }
    function customer() { return signedIn() && (hasRole("customer") || !("role" in request.auth.token)) && !owner(); }
    function seller() { return hasRole("seller"); }
    function rider() { return hasRole("rider"); }
    function wholesaler() { return hasRole("wholesaler"); }
    function supportStaff() { return hasRole("support"); }
    function staffTicket(t) { return supportStaff() && t.assignedStaffUid == request.auth.uid; }

    function validMoney(d) {
      return d.subtotalPaise is int && d.deliveryFeePaise is int
        && d.discountPaise is int && d.totalPaise is int
        && d.subtotalPaise >= 0 && d.deliveryFeePaise >= 0
        && d.discountPaise >= 0 && d.discountPaise <= d.subtotalPaise
        && d.totalPaise == d.subtotalPaise + d.deliveryFeePaise - d.discountPaise;
    }
    function couponValid(d) {
      return !("couponCode" in d) ||
        (exists(/databases/$(database)/documents/coupons/$(d.couponCode))
          && get(/databases/$(database)/documents/coupons/$(d.couponCode)).data.active == true
          && get(/databases/$(database)/documents/coupons/$(d.couponCode)).data.expiresAt is timestamp
          && get(/databases/$(database)/documents/coupons/$(d.couponCode)).data.expiresAt > request.time);
    }
    function validNewOrder(orderId) {
      let d = request.resource.data;
      return customer()
        && d.keys().hasAll(["id","userId","name","phone","address","pincode","status","subtotalPaise","deliveryFeePaise","discountPaise","totalPaise","items","payment","date","note"])
        && d.keys().hasOnly(["id","userId","name","phone","address","pincode","status","subtotalPaise","deliveryFeePaise","discountPaise","totalPaise","items","payment","date","note","couponCode"])
        && d.id == orderId && d.userId == request.auth.uid && d.status == "Pending"
        && d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.phone is string && d.phone.size() >= 10 && d.phone.size() <= 20
        && d.address is string && d.address.size() > 0 && d.address.size() <= 500
        && d.pincode is string && d.pincode.matches('^[0-9]{6}$')
        && d.items is list && d.items.size() > 0 && d.items.size() <= 50
        && d.payment in ["UPI","Cash on Delivery"] && d.date is timestamp
        && d.note is string && d.note.size() <= 300
        && validMoney(d) && couponValid(d);
    }

    match /users/{uid} {
      allow get: if owner() || (signedIn() && request.auth.uid == uid);
      allow list: if owner();
      allow create: if owner() || (signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(["uid","name","email","phone","createdAt"])
        && request.resource.data.uid == uid);
      allow update: if owner() || (signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","phone","address","photoURL","updatedAt"]));
      allow delete: if owner();
    }

    // Safe, explicitly public fields only. Do not expose legacy settings/main.
    match /publicSettings/{docId} {
      allow get: if docId == "main";
      allow list: if false;
      allow write: if owner();
    }
    match /privateSettings/{docId} {
      allow read, write: if owner();
    }
    match /settings/{docId} {
      allow read, write: if owner();
    }

    match /products/{productId} {
      allow get, list: if owner() || resource.data.active == true;
      allow create: if owner();
      allow update: if owner() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["stock"]);
      allow delete: if owner();
    }
    match /orders/{orderId} {
      allow create: if validNewOrder(orderId);
      allow get, list: if owner() || (signedIn() && resource.data.userId == request.auth.uid);
      // Approval, status, stock and payment changes must go through trusted backend.
      allow update, delete: if false;
    }
    match /coupons/{couponId} {
      allow get: if owner() || (signedIn() && resource.data.active == true);
      allow list, create, update, delete: if owner();
    }

    // Seller-owned catalogue and suborders; ownership is immutable to seller.
    match /sellerProducts/{productId} {
      allow get, list: if owner() || (seller() && resource.data.sellerUid == request.auth.uid);
      allow create: if owner() || (seller() && request.resource.data.sellerUid == request.auth.uid);
      allow update: if owner() || (seller() && resource.data.sellerUid == request.auth.uid
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","description","image","active","updatedAt"]));
      allow delete: if owner();
    }
    match /suborders/{suborderId} {
      allow get, list: if owner() || (seller() && resource.data.sellerUid == request.auth.uid);
      allow create, delete: if owner();
      allow update: if owner() || (seller() && resource.data.sellerUid == request.auth.uid
        && request.resource.data.sellerUid == resource.data.sellerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["sellerStatus","sellerNote","updatedAt"]));
    }

    match /riderTasks/{taskId} {
      allow get, list: if owner() || (rider() && resource.data.assignedRiderUid == request.auth.uid);
      allow create, delete: if owner();
      allow update: if owner() || (rider() && resource.data.assignedRiderUid == request.auth.uid
        && request.resource.data.assignedRiderUid == resource.data.assignedRiderUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deliveryStatus","proofUrl","deliveredAt","updatedAt"]));
    }

    match /wholesalers/{uid} {
      allow get: if owner() || (wholesaler() && request.auth.uid == uid);
      allow list: if owner();
      allow create: if owner();
      allow update: if owner() || (wholesaler() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["businessName","phone","address","updatedAt"]));
      allow delete: if owner();
    }
    match /b2bOrders/{orderId} {
      allow get, list: if owner() || (wholesaler() && resource.data.wholesalerUid == request.auth.uid);
      allow create, update, delete: if owner();
    }

    match /supportTickets/{ticketId} {
      allow create: if signedIn() && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(["customerUid","subject","message","status","createdAt"]);
      allow get, list: if owner() || (signedIn() && resource.data.customerUid == request.auth.uid)
        || staffTicket(resource.data);
      allow update: if owner() || (staffTicket(resource.data)
        && request.resource.data.customerUid == resource.data.customerUid
        && request.resource.data.assignedStaffUid == resource.data.assignedStaffUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","staffReply","updatedAt"]));
      allow delete: if owner();
    }

    // Sensitive payment and approval records are server-owned.
    match /payments/{paymentId} {
      allow read: if owner() || (signedIn() && resource.data.userId == request.auth.uid);
      allow write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}